{
  "name": "zero-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "api": "wrangler dev --port 8787",
    "check": "npm run gen && tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "start": "npm run build && wrangler dev --port 8787",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "load": "autocannon -c 100 -d 10 http://127.0.0.1:8787/api/items",
    "knip": "knip",
    "verify": "npm run check && npm run build && npm run budget && npm test && npm run knip",
    "codegen": "orval",
    "budget": "node scripts/bundle-budget.mjs",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "gen": "npm run codegen && npm run types",
    "prepare": "npm run gen",
    "migrate": "wrangler d1 migrations apply zero --remote"
  },
  "dependencies": {
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autocannon": "^9.0.0",
    "knip": "^6.48.0",
    "orval": "^8.49.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
