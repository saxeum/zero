{
  "name": "zero-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "api": "node server/index.js",
    "check": "tsc --noEmit && node --check server/app.js && node --check server/index.js && node --check server/store.js",
    "start": "npm run build && npm run api",
    "test": "node --test server/ src/",
    "coverage": "node --test --experimental-test-coverage server/",
    "load": "autocannon -c 100 -d 10 http://localhost:3000/api/items",
    "knip": "knip",
    "verify": "npm run check && npm run build && npm test && npm run knip"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autocannon": "^9.0.0",
    "knip": "^6.48.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
