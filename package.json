{
  "name": "zero-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "api": "node server/index.js",
    "check": "tsc --noEmit && node --check server/app.js && node --check server/index.js && node --check server/store.js",
    "start": "npm run build && npm run api",
    "test": "node --test server/",
    "coverage": "node --test --experimental-test-coverage server/"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
